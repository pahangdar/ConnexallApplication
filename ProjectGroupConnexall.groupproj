<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{69C20021-BD15-477C-AF3C-253DF85837B2}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="ConnexallApplication.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="ConnexallUnitTest.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="ConnexallApplication">
        <MSBuild Projects="ConnexallApplication.dproj"/>
    </Target>
    <Target Name="ConnexallApplication:Clean">
        <MSBuild Projects="ConnexallApplication.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ConnexallApplication:Make">
        <MSBuild Projects="ConnexallApplication.dproj" Targets="Make"/>
    </Target>
    <Target Name="ConnexallUnitTest">
        <MSBuild Projects="ConnexallUnitTest.dproj"/>
    </Target>
    <Target Name="ConnexallUnitTest:Clean">
        <MSBuild Projects="ConnexallUnitTest.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ConnexallUnitTest:Make">
        <MSBuild Projects="ConnexallUnitTest.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="ConnexallApplication;ConnexallUnitTest"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="ConnexallApplication:Clean;ConnexallUnitTest:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="ConnexallApplication:Make;ConnexallUnitTest:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
